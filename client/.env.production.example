# Production env vars for Vercel (client/)
# Add these in Vercel → Project → Settings → Environment Variables

# Required for chat + map (after deploying server/ on Render):
VITE_API_URL=https://your-api.onrender.com

# Optional fallback for map only (same value as MAPBOX_TOKEN):
# VITE_MAPBOX_TOKEN=pk.your_mapbox_token
